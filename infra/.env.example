# Copier dans apps/api/.env (jamais commité). Tous les secrets sont côté serveur.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://task:task@127.0.0.1:5432/task
TEST_DATABASE_URL=postgres://task:task@127.0.0.1:5432/task_test
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:5173
COOKIE_SECRET=change-me-32-chars-minimum-please
# ── IA ─────────────────────────────────────────────────────────────────────────
# Fournisseur par défaut : local (Ollama / llama.cpp / vLLM, OpenAI-compatible, texte uniquement).
# Valeurs : local | hermes | anthropic | fake
AI_PROVIDER=local
# Slots par tâche (optionnels) : chat = conversation, fast = humeur/extraction mémoire, deep = conversations importantes.
# Exemple recommandé "Hermes + local" :  AI_CHAT_PROVIDER=hermes  AI_FAST_PROVIDER=local
# AI_CHAT_PROVIDER=hermes
# AI_FAST_PROVIDER=local
# AI_DEEP_PROVIDER=anthropic
AI_WARMUP=true

# LLM local (Ollama par défaut). Modèles conseillés : hermes3:8b (chat), hermes3:3b (fast) ; GPU 24 Go : hermes3:70b en deep.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_CHAT_MODEL=hermes3:8b
LOCAL_FAST_MODEL=hermes3:3b
# LOCAL_DEEP_MODEL=hermes3:70b
# LOCAL_LLM_API_KEY=

# Hermes Agent (Nous Research) : `hermes gateway` avec API_SERVER_ENABLED=true dans ~/.hermes/.env
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642/v1
# HERMES_AGENT_API_KEY=change-me-local-dev
HERMES_AGENT_MODEL=hermes-agent

# Anthropic (optionnel, pour le slot deep) — clé serveur uniquement.
# ANTHROPIC_API_KEY=sk-ant-...
